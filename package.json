{
  "name": "@ninkch/dsh-artcraft",
  "version": "0.1.1",
  "type": "module",
  "description": "Drive the open-source ArtCraft studio apps (PhotoCraft / FilmCraft / EffectCraft) from DeepSeek Harness — agent tools + a same-origin HTTP API for headless CLI runs and the JSON control channel.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "artcraft",
    "photocraft",
    "filmcraft",
    "effectcraft",
    "automation",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "artcraft.config.json.example",
    "README.md",
    "README.zh-CN.md",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
