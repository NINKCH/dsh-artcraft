{
  "name": "@ninkch/dsh-artcraft",
  "version": "0.3.3",
  "type": "module",
  "description": "Drive the open-source ArtCraft studio suite (13 family apps: PhotoCraft, VectorCraft, FilmCraft, LightCraft, PdfCraft, EffectCraft, DesignCraft, WordCraft, DeckCraft, GridCraft, CADCraft, SoundCraft, FigCraft) from DeepSeek Harness: agent tools, a same-origin HTTP API, a bundled craft skill pack, and plugins-page status with self-update.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "artcraft",
    "photocraft",
    "filmcraft",
    "effectcraft",
    "skills",
    "automation",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "author": "NINKCH",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NINKCH/dsh-artcraft.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "selftest": "node scripts/selftest.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./skills": "./skills.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "skills.js",
    "skills",
    "cordis.patch.yml",
    "artcraft.config.json.example",
    "apps",
    "recipes",
    "CHANGELOG.md",
    "README.md",
    "README.zh-CN.md",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
